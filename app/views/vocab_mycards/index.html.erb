<%= stylesheet_link_tag "jlpt", media: "all", 'data-turbo-track': 'reload' %>
<div class="m-auto row">
  <% unless @vocab_code.present? %>
  <div class="container">
    <div class="row mt-2">
      <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <%= link_to t('quizes.start'), period_quizes_path(period: @period), class: 'btn btn-outline-dark rounded-0 px-3' %>
        <%= form_with url: vocab_mycards_path, method: :get, local: true, id: 'job', role: 'form', class: 'd-flex flex-row align-items-center' do |f| %>
          <% options = [['all', 'all'], ['one_day', '1d'], ['one_month', '1m'], ['three_months', '3m']].map { |label, period| [t("quizes.learning_history.#{label}"), period] } %>
          <%= f.select :selected_item, options_for_select(options, @period),
                       { include_blank: false },
                       class: 'form-select rounded-0 m-1 w-auto', onchange: 'this.form.requestSubmit();' %>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>

  <% if @message.present? %>
    <%= @message %>
  <% end %>

  <div class="row">
    <div class="col-md-12" id="test"></div>
  </div>
  <% last_date = nil %>
  <% @cards.each do |card| %>
    <% current_date = card.created_at.strftime('%Y/%m/%d') %>
    <% if last_date != current_date %>
      <div style="width: 100%; background: lightblue; text-align: center; margin: 10px;">
        <%= current_date %>
      </div>
      <% last_date = current_date %>
    <% end %>
    <div class="col-sm-3 mt-1" style="min-width: 150px;">
      <div class="card rounded-0" style="height: 160px; overflow: auto;">
        <div class="card-body text-center">
          <p class="card-text"><%= card.vocab_table.vocab_read %></p>
          <hr class="m-1">
          <%= link_to card.vocab_table.vocab_code, page_mylang_vocab_mycards_path(vocab_id: card.vocab_table_id), class: 'underline d-inline-block w-100 fs-2 link-opacity-50-hover ink-dark' %>
          <% lang_id = current_user.lang_id %>
          <% if card.vocab_table.vocab_nations.present? %>
            <% text = card.vocab_table.vocab_nations.where(hide_flg: false, lang: lang_id) %>
            <% text = card.vocab_table.vocab_nations.where(hide_flg: false, lang: 'EN') if text.blank? %>
          <% end %>

          <hr class="m-1">
          <p class="card-text">
            <% if text.length > 1 %>
              <% text.each_with_index do |txt, index| %>
                <%= txt.nation_code %><%= index < text.length - 1 ? ',' : '' %>
              <% end %>
            <% else %>
              <%= text.first.nation_code %>
            <% end if text.present? %>
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>
