<div class="d-flex align-items-center w-100">
  <button type="button"
          id="toggleConversation"
          class="btn btn-outline-dark ms-auto mb-1">
          🎧 Listening Mode
    </button>
</div>

<div class="row justify-content-center">
  <div class="col">
    <div class="card mb-1">
      <% if @audio_d.blank? %>
        <p class="text-center text-muted mt-3">表示できる音声データがありません。</p>
      <% else %>
        <ul class="list-group list-group-flush text-left">
          <% conversation_lines = @audio_d.lazy
               .map { |audio| [audio, get_content(audio, @selected_language)] }
               .take_while { |_audio, text| text.present? }
               .to_h %>
          <% conversation_lines = link_vocab_texts(conversation_lines) if @selected_language.blank? && conversation_lines.present? %>

          <% if conversation_lines.present? %>
            <% conversation_lines.each do |audio, text| %>
              <li class="list-group-item dropdown-item" style="<%= audio.customer_flg ? 'text-align: end; background-color: #e9f5ff;' : '' %>">
                <h6 class="text-wrap text-break js-conversation"><%= text %></h6>
                <audio controls>
                  <source src="<%= get_media(audio, @selected_language) %>" type="audio/mpeg" />
                </audio>
                <button type="button" class="btn btn-light border mb-3 btn-sm" onclick="toggleConversation(this)">
                  <i class="fas fa-eye"></i>
                </button>
              </li>
            <% end %>
          <% else %>
            <li class="list-group-item text-muted text-center">
              表示できる音声データがありません。
            </li>
          <% end %>

        </ul>
      <% end %>
    </div>
  </div>
</div>
