<div class="container-fluid m-auto">
  <div class="row mt-5 mb-3">
    <div class="col">
      <h1 class="text-left fs-2 fs-md-1">会話</h1>
    </div>
<div class="col d-flex justify-content-end flex-wrap gap-2">
  <%= form_for :title_nation, url: audio_d_specified_conversations_path,
               html: { id: 'title_nations', role: 'form', method: :get },
               class: 'd-flex flex-md-nowrap flex-wrap justify-content-end gap-2', remote: true do |form| %>

    <% audio = @audio_c.order(:title_sort).map { |c| [title_nation(c), c.id] } %>
    <% first_item = @audio_c.order(:title_sort).first %>
    <% audio_case = first_item.audio_c_contents.map { |ac| [content_nation(ac), ac.id] } if first_item.present? %>
    <% constant_languages = ['JP', 'EN'] 
       user_language = current_user.lang_id

      # Add user language only if it's not JP or EN
      language_options = constant_languages.dup
      if user_language.present? && !constant_languages.include?(user_language)
        language_options << user_language
      end
    %>

    <div class="d-inline-block w-100" style="min-width: 150px; max-width: 250px;">
      <%= form.select :title_nation,
        options_for_select(audio, ''),
        { include_blank: false },
        { class: 'form-select', onchange: 'optionChange(this);' } %>
    </div>

    <div class="d-inline-block w-100" style="min-width: 150px; max-width: 250px;">
      <%= form.select :content_id,
        options_for_select(audio_case || [], ''),
        { include_blank: false },
        { class: 'form-select' } %>
    </div>
    
    <% language_options.each_with_index do |lang, index| %>
        <%= form.radio_button :language, lang, id: "language_#{lang}", class: 'btn-check visually-hidden', autocomplete: 'off', checked: index.zero? %>
        <%= form.label :language, lang, for: "language_#{lang}", class: 'btn btn-primary mb-1 mr-sm-2' %>
    <% end %>

    <div class="d-inline-block w-100" style="max-width: 250px;">
      <button type="submit" class="btn btn-info w-100">
        <i class="fas fa-search"></i>
      </button>
    </div>

  <% end %>
</div>

  </div>
  <style>
    .btn-primary {
      background-color: aliceblue;
      color: black;
    }

    .btn-primary:hover {
      background-color: #007bff; /* Change to desired hover color */
    }
  
    .btn-primary.active {
      background-color: #007bff; /* Change to desired selected color */
    }
  </style>
  <hr class="mx-0 border border-secondary border-2 opacity-75">
  <div class="col">
    <div id="audio_d"></div>
  </div>
</div>


