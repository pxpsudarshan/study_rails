<div class="container offers-page py-3">
  <div class="card border shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
      <h1 class="h5 mb-3"><%= t('offers_ui.filters') %></h1>
      <%= form_for :search, url: kaisha_offers_path, method: :get, remote: true, html: { id: 'offer-search', class: 'form-horizontal' } do |f| %>
        <% search = params[:search] || {} %>
        <div class="row g-3">
          <div class="col-md-4">
            <%= f.label :occupation, t('offers_ui.occupation'), class: 'form-label' %>
            <%= f.select :occupation, options_for_select(occupation_array, search[:occupation]), {}, class: 'form-select' %>
          </div>
          <div class="col-md-4">
            <%= f.label :rate, t('offers_ui.rate'), class: 'form-label' %>
            <%= f.select :rate, options_for_select((1..10).map { |n| ["#{n * 10}%", n * 10] }, search[:rate]), { include_blank: t('offers_ui.any_rate') }, class: 'form-select' %>
          </div>
          <div class="col-md-4">
            <%= f.label :user, t('offers_ui.scope'), class: 'form-label' %>
            <%= f.select :user, options_for_select([[t('offers_ui.all_users'), 0], [t('offers_ui.applicants'), 1]], search[:user]), {}, class: 'form-select' %>
          </div>
          <fieldset class="col-12">
            <legend class="fs-6 mb-2"><%= t('offers_ui.source') %></legend>
            <% [[t('offers_ui.company_words'), 0], [t('offers_ui.genres'), 1]].each do |label, value| %>
              <div class="form-check form-check-inline">
                <%= f.radio_button :search_mode, value, checked: search[:search_mode].to_i == value, class: 'form-check-input' %>
                <%= f.label :search_mode, label, value: value, class: 'form-check-label' %>
              </div>
            <% end %>
          </fieldset>
          <div class="col-12" id="offer-genres">
            <%= f.label :genre, t('offers_ui.genres'), class: 'form-label' %>
            <%= f.select :genre, options_for_select(@genres, search[:genre]), { include_hidden: false }, multiple: true, class: 'form-select genre_select', data: { placeholder: t('offers_ui.genre_hint'), language: I18n.locale } %>
          </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
          <%= f.submit t('offers_ui.search'), class: 'btn btn-primary px-4', data: { disable_with: t('offers_ui.searching') } %>
          <%= link_to t('offers_ui.reset'), kaisha_offers_path, class: 'text-secondary text-decoration-underline' %>
          <span class="small text-muted" id="offer-search-status" role="status" data-error="<%= t('offers_ui.search_error') %>"></span>
        </div>
      <% end %>
    </div>
  </div>
  <div id="offer_list" aria-live="polite"><%= render 'offer_list' %></div>
</div>
