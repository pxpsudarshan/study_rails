<% @sub_genres.each do |sg| %>
  <div class="genre-item mb-2" data-id="<%= sg[:id] %>">

    <%= link_to sub_genre_chart_kaisha_progress_index_path(genre_id: sg[:id], user_id: sg[:user_id]),
                remote: true,
                class: "genre-link d-flex justify-content-between text-decoration-none text-dark" do %>

      <span>▶ <%= sg[:name] %></span>
      <span><%= sg[:progress] %>%</span>

    <% end %>

    <div class="progress mt-1" style="height: 8px;">
      <div class="progress-bar bg-success"
           style="width: <%= sg[:progress] %>%"></div>
    </div>

    <!-- 👇 再帰用 -->
    <div class="children ms-4 mt-2"></div>

  </div>
<% end %>
