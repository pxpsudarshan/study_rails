<%= paginate @users, remote: true %>
<div style="white-space: nowrap; min-width: 800px;">
<table class="table table-bordered table-hover table-sm text-center">
  <thead>
    <tr class="table-success">
      <th><%= t('activerecord.attributes.user.name') %></th>
      <th><%= t('activerecord.attributes.user.email') %></th>
      <th><%= t('activerecord.attributes.user.last_sign_in') %></th>
      <th><%= t('activerecord.attributes.user.login_count') %></th>
      <th><%= t('activerecord.attributes.user.studyed') %></th>
      <th><%= t('activerecord.attributes.user.learned') %></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= link_to user.name, chart_kaisha_progress_index_path(user_id: user.id) %></td>
        <td><%= user.email %></td>
        <td><%= user.current_sign_in_at&.strftime('%Y/%m/%d') || '-' %></td>
        <td><%= user.sign_in_count %></td>
        <td><%= user.vocab_mycards.count %></td>
        <td><%= user.vocab_mycards.where(mycard_level: 1).count %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
<div class="d-flex justify-content-between align-items-center mb-2">
  <%= paginate @users, remote: true %>
  <%= javascript_tag do %>
    $(function() {
      NProgress.done();
    });
  <% end %>
  <strong><%= page_entries_info @users, entry_name: '' %></strong>
</div>
