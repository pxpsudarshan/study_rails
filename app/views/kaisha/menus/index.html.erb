<div class="container-fluid p-3 p-lg-4">
  <header class="mb-4">
    <h1 class="h3 fw-bold mb-1"><%= t('sidebar.dashboard') %></h1>
    <p class="text-muted mb-0"><%= current_comp.name %></p>
  </header>

  <% sidebar_groups.each do |heading, links| %>
    <section class="mb-4">
      <h2 class="h5 fw-bold mb-3"><%= heading %></h2>
      <div class="row g-3">
        <% links.each do |label, path, icon| %>
          <% next if path == kaisha_menus_path %>
          <div class="col-12 col-md-6 col-xl-4">
            <%= link_to path, class: 'btn btn-outline-dark rounded-0 d-flex align-items-center gap-3 h-100 p-3 text-start' do %>
              <i class="fas fa-<%= icon %> fa-fw flex-shrink-0" aria-hidden="true"></i>
              <span><%= strip_tags(t(label)).strip %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
