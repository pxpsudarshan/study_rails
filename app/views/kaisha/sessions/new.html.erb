<div class="card w-50 m-auto border-company rounded shadow-sm p-3">
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'form-horizontal text-center' }) do |f| %>
  <%= embedded_svg 'niho_logo_newBlack.svg', class: 'auth-logo m-4' %>
  <%= render "kaisha/shared/error_messages", resource: resource %>
  <div class="form-floating w-75 mx-auto mt-2">
    <%= f.email_field :email, placeholder: 'name@example.com', class: 'form-control', required: false %>
    <%= f.label :email %>
  </div>
  <div class="form-floating w-75 mx-auto mt-2">
    <%= f.password_field :password, placeholder: 'パスワード', class: 'form-control', required: false %>
    <%= f.label :password %>
  </div>
  <% if devise_mapping.rememberable? -%>
  <div class="form-check my-3">
    <%= f.label :remember_me do %>
      <%= f.check_box :remember_me, checked: true, value: true, class: 'form-check-input float-none' %> <%= t('activerecord.attributes.user.remember_me') %>
    <% end %>
  </div>
  <% end %>
  <%= f.submit t('.sign_in'), class: 'w-75 m-auto btn btn-lg btn-primary' %>
<% end %>
<p class="mt-5 mb-3 text-center"><%= render "kaisha/shared/links" %></p>
</div>

