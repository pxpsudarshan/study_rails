<%= stylesheet_link_tag "jlpt", media: "all", 'data-turbo-track': 'reload' %>

<%= form_with url: vocab_genres_path,
                method: :get,
                local: true,
                data: { turbo: false },
                class: "" do |f| %>

<div class="m-auto w-75 row justify-content-end mb-3">
    <% options_array = @children.map { |c| [current_user.lang_id == 'JP' ? c.title : (get_content(c, current_user.lang_id)||'Empty') , c.id] } %>
    <%= f.hidden_field :id, value: @id %>

  <div class="col-md-1 col-form-label">
      Select Genre:
  </div>
  <div class="col-md-auto">
    <%= f.select :child_id,
          options_for_select(options_array, params[:child_id]),
          { include_blank: true }, 
          { class: "form-select", onchange: "this.form.requestSubmit();" } %>
  </div> 
</div>
<% end %>
<div class="m-auto row" id="vocab_genres">
  <%= @cards.blank? ? 'NO DATA' : (render 'vocab_genre_list') %>
</div>
