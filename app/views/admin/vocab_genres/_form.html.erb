<%= form_for [:admin, @vocab_genre], html: { class: 'needs-validation', novalidate: true } do |f| %>
<%= f.hidden_field :vocab_genre_id %>
<% if @vocab_genre.errors.any? %>
<div class="row">
  <div class="col-md-12">
    <div id="error_explanations" class="alert fade show alert-danger">
      <ul>
        <% @vocab_genre.errors.full_messages.each do |msg| %>
        <li>
          <%= content_tag(:div, msg) %>
        </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
<% end %>

<div class="row mb-3">
  <label class='col-md-2 col-form-label text-end'><%= t('activerecord.attributes.vocab_genre.sort') %><%== t('common.flg_required') %></label>
  <div class="col-md-3">
    <div class="input-group">
      <%= f.text_field :sort, class: 'form-control', required: true %>
    </div>
  </div>
</div>
<div class="row mb-3">
  <label class='col-md-2 col-form-label text-end'><%= t('activerecord.attributes.vocab_genre.title') %><%== t('common.flg_required') %></label>
  <div class="col-md-3">
    <div class="input-group">
      <%= f.text_field :title, class: 'form-control', required: true %>
    </div>
  </div>
</div>

<div class="row mb-3">
  <div class="col-md-6">
    <table class="table table-bordered table-sm">
      <thead>
        <tr class="table-success">
          <th class="text-start w-25"><%= t('activerecord.attributes.language.language') %></th>
          <th class="text-start"><%= t('activerecord.attributes.language.content') %></th>
          <th class="text-start"><%= t('common.destroy') %></th>
        </tr>
      </thead>
      <tbody id="langs">
      <%= f.fields_for :languages do |ln| %>
        <% render 'language_fields', f: ln %>
      <% end %>
      </tbody>
    </table>
    <%= link_to_add_association t('buttons.lang_add').html_safe, f, :languages,
        'data-association-insertion-method'    => 'append' ,
        'data-association-insertion-node'      => '#langs', class: "btn btn-sm btn-primary"
    %>
  </div>
</div>

<div class="row mb-3">
  <div class="col-md-8">
    <label class='col-md-2 col-form-label text-start'><%= '語彙一覧' %></label>
    <table class="table table-bordered table-sm">
      <thead>
        <tr class="table-success">
          <th class="text-start"><%= t('activerecord.attributes.vocab_genre_content.sort') %><%== t('common.flg_required') %></th>
          <th class="text-start"><%= t('activerecord.attributes.vocab_table.vocab_code') %></th>
          <th class="text-start"><%= t('activerecord.attributes.vocab_table.vocab_read') %></th>
          <th class="text-start"><%= t('activerecord.attributes.vocab_table.example') %></th>
          <th class="text-start"><%= t('activerecord.attributes.vocab_table.jlpt_level') %></th>
          <th class="text-start"><%= t('activerecord.attributes.vocab_genre_content.hide_flg') %></th>
          <th class="text-start"><%= t('common.destroy') %></th>
        </tr>
      </thead>
      <tbody id="vocab_tables">
      <%= f.fields_for :vocab_genre_contents do |vgc| %>
        <% render 'vocab_genre_content_fields', f: vgc %>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
<div class="form-actions">
  <% if @vocab_genre.vocab_genre_id.present? %>
    <%= link_to t('buttons.back'), admin_vocab_genre_path(id: @vocab_genre.vocab_genre_id), class: "btn btn-sm btn-secondary" %>
  <% else %>
    <%= link_to t('buttons.back'), admin_vocab_genres_path, class: "btn btn-sm btn-secondary" %>
  <% end %>
  <%= f.submit t('buttons.submit'), class: "btn btn-sm btn-primary" %>
</div>
<% end %>
