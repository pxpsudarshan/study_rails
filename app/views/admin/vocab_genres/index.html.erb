<div class="row">
  <div class="col-auto mb-3 ml-auto">
    <%= link_to t('buttons.new').html_safe, new_admin_vocab_genre_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <table class="table table-bordered table-hover table-sm">
      <thead>
        <tr class="table-success">
          <% unless current_user.comp&.channel_id.present? %>
          <th class="text-start"><%= t('activerecord.attributes.channel.channel_name') %></th>
          <% end %>
          <th class="text-start"><%= t('activerecord.attributes.vocab_genre.title') %></th>
          <th class="text-start"><%= t('common.edit') %></th>
          <th class="text-start"><%= t('common.destroy') %></th>
        </tr>
      </thead>
      <tbody>
      <% @vocab_genres.each do |vg| %>
        <tr class="details_row nested-fields">
          <% unless current_user.comp&.channel_id.present? %>
          <td class="text-start text-nowrap"><%= vg.channel&.channel_name %></td>
          <% end %>
          <td class="text-start text-nowrap w-75"><%= link_to vg.title, admin_vocab_genre_path(id: vg.id) %></td>
          <td class="text-start text-nowrap"><%= link_to t('buttons.edit').html_safe, edit_admin_vocab_genre_path(id: vg.id), class: 'btn btn-sm btn-primary' %></td>
          <td class="text-start text-nowrap"><%= link_to t('buttons.destroy').html_safe, admin_vocab_genre_path(id: vg.id), method: :delete, class: 'btn btn-sm btn-danger' %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
