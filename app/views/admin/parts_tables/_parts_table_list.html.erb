<%= paginate @parts_table, remote: true %>
<div style="white-space: nowrap; min-width: 800px;">
  <table class="table table-bordered table-hover table-sm">
    <thead>
      <tr class="table-success">
        <th class="text-start"><%= t('activerecord.attributes.parts_table.parts_code') %></th>
        <th class="text-start"><%= t('activerecord.attributes.parts_table.kanji_body') %></th>
        <th class="text-start"><%= t('common.edit') %></th>
        <th class="text-start"><%= t('common.destroy') %></th>
      </tr>
    </thead>
    <tbody>
    <% @parts_table.each do |part| %>
      <tr class="details_row nested-fields">
        <td class="text-start text-nowrap w-25"><%= part.parts_code %></td>
        <td class="text-start"><%= part.kanji_tables.map{ |kt| kt.kanji_code }.join(', ') if part.kanji_tables.present? %></td>
        <td class="text-start text-nowrap"><%= link_to t('buttons.edit').html_safe, edit_admin_parts_table_path(id: part.id), class: 'btn btn-sm btn-primary' %></td>
        <td class="text-start text-nowrap"><%= link_to t('buttons.destroy').html_safe, admin_parts_table_path(id: part.id), method: :delete, class: 'btn btn-sm btn-danger' %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
<strong><%= page_entries_info @parts_table, :entry_name => '' %></strong>
<%= paginate @parts_table, remote: true %>
<%= javascript_tag do %>
  $(function() {
    NProgress.done();
  });
<% end %>
