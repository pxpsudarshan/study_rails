<%= form_for [:admin, @block_ip], html: { class: 'needs-validation', novalidate: true, id: 'block_ip', role: 'form' } do |f| %>
<% if @block_ip.errors.any? %>
<div class="row">
  <div class="col-md-12">
    <div id="error_explanations" class="alert fade show alert-danger">
      <ul>
        <% @block_ip.errors.full_messages.each do |msg| %>
        <li>
          <%= content_tag(:div, msg) %>
        </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
<% end %>
<div class="row">
  <div class="col-md-7">
    <div id="error_explanations_required" class="alert text-center fade alert-danger">
      必須項目を入力してください。
    </div>
    <table class="table table-bordered table-sm">
      <tbody>
        <tr>
          <th class="table-success w-25 text-nowrap align-middle"><%= t('activerecord.attributes.block_ip.ipaddr') %><%== t('common.flg_required') %></th>
          <td class="text-nowrap align-middle">
            <div class="input-group">
              <%= f.text_field :ipaddr, class: 'form-control', required: true %>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
<div class="row">
  <div class="col-md-12">
    <div class="form-actions">
      <%= link_to t('buttons.cancel'), admin_block_ips_path, class: "btn btn-secondary" %>
      <%= button_tag t('buttons.create'), type: 'submit', class: "btn btn-warning" %>
      <% if @block_ip.persisted? %>
      <%= link_to t('buttons.destroy').html_safe, admin_block_ip_path, method: :delete, class: 'btn btn-danger' %>
      <% end %>
    </div>
  </div>
</div>
<% end %>
<%= javascript_tag do %>
$(function() {
'use strict';
  // Fetch all the forms we want to apply custom Bootstrap validation styles to
  var forms = document.getElementsByClassName('needs-validation');
  // Loop over them and prevent submission
  var validation = Array.prototype.filter.call(forms, function(form) {
    form.addEventListener('submit', function(event) {
      if (form.checkValidity() === false) {
        $('#error_explanations_required').addClass('show');
        window.scrollTo(0,0);
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  });
});
<% end %>
