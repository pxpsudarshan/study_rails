<% if current_user.access_type == User::ACCESS_TYPE::KANRISHA || (current_user.access_type == User::ACCESS_TYPE::POWER_USER && current_user.lang_id == f.object.language ) || f.object.new_record? %>
<tr class="nested-fields">
  <td class="text-center">
  <% if current_user.access_type == User::ACCESS_TYPE::KANRISHA %>
    <%= f.select :language, options_for_select(langs, f.object.language), {include_blank: true}, class: 'form-select', required: true %>
  <% else %>
    <%= f.select :language, options_for_select(langs(current_user.lang_id), f.object.language), {include_blank: false}, class: 'form-select' %>
  <% end %>
  </td>
  <td class="text-center">
    <%= f.text_area :content, class: 'form-control' %>
  </td>
  <td class="text-center text-nowrap">
    <%= link_to_remove_association t('buttons.destroy').html_safe, f, class: "btn btn-danger" %>
    <%= f.hidden_field :skip_flg, value: true %>
  </td>
</tr>
<% end %>
