<% if current_user.access_type == User::ACCESS_TYPE::KANRISHA || (current_user.access_type == User::ACCESS_TYPE::POWER_USER && current_user.lang_id == f.object.lang ) || f.object.new_record? %>
<tr class="nested-fields" data-id="<%= f.object.id %>">
  <td class="text-center">
    <% if current_user.access_type == User::ACCESS_TYPE::KANRISHA %>
      <%= f.select :lang, options_for_select(langs, f.object.lang), {include_blank: true}, class: 'form-select', required: true %>
    <% else %>
      <%= f.select :lang, options_for_select(langs(current_user.lang_id), f.object.lang), {include_blank: false}, class: 'form-select' %>
    <% end %>
  </td>
  <td class="text-center">
    <%= f.text_field :nation_code, class: 'form-control', required: false %>
  </td>
  <td class="text-center">
    <%= f.text_field :example, class: 'form-control' %>
  </td>
  <td class="text-center">
    <%= text_field_tag :created_at, f.object.created_at&.strftime("%Y/%m/%d %H:%M"), class: 'form-control', readonly: true %>
  </td>
  <td class="text-center">
    <%= text_field_tag :created_by, User.with_deleted.where(id: f.object.created_by).first&.name, class: 'form-control', readonly: true %>
  </td>
  <td class="text-center">
    <%= text_field_tag :updated_at, f.object.updated_at&.strftime("%Y/%m/%d %H:%M"), class: 'form-control', readonly: true %>
  </td>
  <td class="text-center">
    <%= text_field_tag :updated_by, User.with_deleted.where(id: f.object.updated_by).first&.name, class: 'form-control', readonly: true %>
  </td>
  <td class="text-center text-nowrap">
    <%= f.check_box :hide_flg, {class: 'form-check-input'} %>
  </td>
  <td class="text-center text-nowrap">
    <%= link_to_remove_association t('buttons.destroy').html_safe, f, class: "btn btn-danger" %>
  </td>
</tr>
<% end %>
