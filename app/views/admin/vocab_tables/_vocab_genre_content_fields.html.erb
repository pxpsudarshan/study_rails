<tr class="nested-fields">
  <td class="text-center">
    <%= f.number_field :sort, min: 0, class: 'form-control', required: true %>
  </td>
  <td class="text-center w-50">
    <% genres = VocabGenre.all.map{ |vg| [vg.title, vg.id] } %>
    <%= f.select :vocab_genre_id, options_for_select(genres, f.object.vocab_genre_id), {include_blank: true}, class: 'form-select genre_select', required: true %>
  </td>
  <td class="text-center text-nowrap">
    <%= f.check_box :hide_flg, {class: 'form-check-input'} %>
  </td>
  <td class="text-center text-nowrap">
    <%= link_to_remove_association t('buttons.destroy').html_safe, f, class: "btn btn-danger" %>
  </td>
</tr>
