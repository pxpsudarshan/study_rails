<%= paginate @channels, remote: true %>
<div style="white-space: nowrap; min-width: 800px;">
<table class="table table-bordered table-hover table-sm">
  <thead>
    <tr class="table-success">
      <th class="text-center"><%= t('buttons.show') %></th>
      <th class="text-center"><%= t('activerecord.attributes.channel.channel_name') %></th>
    </tr>
  </thead>
  <tbody>
    <% @channels.each do |channel| %>
    <tr class="details_row nested-fields">
      <td class="text-center"><%= link_to t('buttons.edit').html_safe, edit_admin_channel_path(id: channel.id), class: "btn btn-secondary btn-sm" %></td>
      <td class="text-center"><%= channel.channel_name %></td>
    </tr>
    <% end %>
  </tbody>
</table>
</div>
<strong><%= page_entries_info @channels, :entry_name => '' %></strong>
<%= paginate @channels, remote: true %>
<%= javascript_tag do %>
  $(function() {
    NProgress.done();
  });
<% end %>
