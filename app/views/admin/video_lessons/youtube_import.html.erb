<div class="container py-4" style="max-width: 760px">
  <h1 class="h3 mb-4"><%= t('video_learning.youtube.import') %></h1>
  <%= render 'youtube_connection' %>
  <%= form_with model: @video_lesson, url: youtube_tracks_admin_video_lessons_path, local: true, class: 'card card-body' do |f| %>
    <%= f.label :title, t('video_learning.lesson_title'), class: 'form-label' %>
    <%= f.text_field :title, required: true, maxlength: 200, class: 'form-control mb-3' %>
    <%= f.label :youtube_url, t('video_learning.url'), class: 'form-label' %>
    <%= f.text_field :youtube_url, required: true, class: 'form-control mb-3', placeholder: 'https://www.youtube.com/watch?v=…' %>
    <%= f.label :video_genre_id, t('video_learning.category'), class: 'form-label' %>
    <%= f.collection_select :video_genre_id, @categories, :id, :label, { include_blank: t('video_learning.uncategorized'), selected: params.dig(:video_lesson, :video_genre_id) || @video_lesson.video_genre_id }, class: 'form-select mb-3' %>
    <p class="text-muted"><%= t('video_learning.draft_help') %></p>
    <%= f.submit t('video_learning.youtube.find'), class: 'btn btn-primary' %>
  <% end %>
  <% if @tracks.present? %>
    <%= form_with url: import_youtube_admin_video_lessons_path, local: true, class: 'card card-body mt-3' do %>
      <%= hidden_field_tag 'video_lesson[title]', @video_lesson.title %>
      <%= hidden_field_tag 'video_lesson[youtube_url]', @video_lesson.youtube_url %>
      <%= hidden_field_tag 'video_lesson[video_genre_id]', params.dig(:video_lesson, :video_genre_id) %>
      <%= label_tag :caption_id, t('video_learning.youtube.language'), class: 'form-label' %>
      <%= select_tag :caption_id, options_for_select(@tracks.map { |track| [[track.dig('snippet', 'language'), track.dig('snippet', 'name')].compact.reject(&:blank?).join(' — '), track['id']] }), class: 'form-select mb-3', required: true %>
      <%= submit_tag t('video_learning.youtube.import'), class: 'btn btn-primary' %>
    <% end %>
  <% end %>
  <%= link_to t('video_learning.library'), admin_video_lessons_path, class: 'btn btn-link mt-3' %>
</div>
