<%= paginate @kanji_table, remote: true %>
<div style="min-width: 800px;">
  <table class="table table-bordered table-hover table-sm">
    <thead>
      <tr class="table-success">
        <th class="text-start"><%= t('activerecord.attributes.kanji_table.kanji_code') %></th>
        <th class="text-start"><%= t('activerecord.attributes.kanji_table.parts_body') %></th>
        <th class="text-start"><%= t('activerecord.attributes.kanji_table.vocab_body') %></th>
        <th class="text-start"><%= t('common.edit') %></th>
        <th class="text-start"><%= t('common.destroy') %></th>
      </tr>
    </thead>
    <tbody>
    <% @kanji_table.each do |kanji| %>
      <tr class="details_row nested-fields">
        <td class="text-start"><%= kanji.kanji_code %></td>
        <td class="text-start text-nowrap"><%= kanji.parts_tables.map{ |pt| pt.parts_code }.join(', ') if kanji.parts_tables.present? %></td>
        <td class="text-start w-75"><%= kanji.vocab_tables.map{ |vt| vt.vocab_code }.join(', ') if kanji.vocab_tables.present? %></td>
        <td class="text-start text-nowrap"><%= link_to t('buttons.edit').html_safe, edit_admin_kanji_table_path(id: kanji.id), class: 'btn btn-sm btn-primary' %></td>
        <td class="text-start text-nowrap"><%= link_to t('buttons.destroy').html_safe, admin_kanji_table_path(id: kanji.id), method: :delete, class: 'btn btn-sm btn-danger' %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
<strong><%= page_entries_info @kanji_table, :entry_name => '' %></strong>
<%= paginate @kanji_table, remote: true %>
<%= javascript_tag do %>
  $(function() {
    NProgress.done();
  });
<% end %>
