<tr class="nested-fields">
  <td class="text-center">
    <%= f.number_field :sort, min: 0, class: 'form-control', required: true %>
  </td>
  <td class="text-center">
    <%= f.text_field :vocab_code, class: 'form-control', required: true %>
  </td>
  <td class="text-center">
    <%= f.text_field :vocab_read, class: 'form-control', required: true %>
  </td>
  <td class="text-center">
    <%= f.text_field :example, class: 'form-control' %>
  </td>
  <td class="text-center">
    <%= f.number_field :jlpt_level, min: 0, class: 'form-control', required: true %>
  </td>
  <td class="text-center text-nowrap">
    <%= f.check_box :hide_flg, {class: 'form-check-input'} %>
  </td>
  <td class="text-center text-nowrap">
    <%= link_to_remove_association t('buttons.destroy').html_safe, f, class: "btn btn-danger" %>
  </td>
</tr>
