<div class="m-auto">
  <div class="row">
    <% @gois.each do |vocab| %>
    <div class="col-sm-3 mt-1" style="min-width: 200px">
      <div class="card rounded-0" style="height: 160px; overflow: auto;">
          <div class="card-body text-center">
            <%= link_to vocab[:vocab_code], kanji_vocab_parts_path(vocab_id: vocab[:vocab_id]), remote: true, class: 'underline d-inline-block w-100 fs-2 link-opacity-50-hover ink-dark' %>
            <hr class="m-1">
            <p class="card-text text-center"> <%= vocab[:eng_mean]&.nation_code %></p>   
            <div class="d-flex flex-wrap justify-content-center">
            <% parts_body = string_to_array(vocab[:parts_body]) %>
            <% parts_body.each_with_index do |part, index| %>
            <% end %>
            <div class="position-absolute top-0 end-0 p-2">
              <%= link_to '<i class="fas fa-book-open"></i>'.html_safe, vocab_info_parts_path(vocab_id: vocab[:vocab_id]), remote: true, class: "btn btn-outline-primary btn-sm" %>
              <!--<button type="button" class="btn btn-sm btn-outline-primary"
              onclick="Openmodal2(
                  '<%= vocab[:parts_body] %>',
                  '<%= vocab[:eng_mean]&.nation_code %>',
                  '<%= vocab[:vocab_code] %>',
                   '<%= vocab[:read_code] %>',
              )"
              data-bs-toggle="modal" data-bs-target="#detailsModal">
              <i class="fas fa-book-open"></i>
              </button>-->
            </div>
          </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div id="detail_modal"></div>
