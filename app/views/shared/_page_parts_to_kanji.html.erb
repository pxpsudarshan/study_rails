 <div class="m-auto row">
  <% @gois.each do |kanji| %>
    <div class="col-sm-3 mt-1" style="min-width: 200px">
      <div class="card rounded-0" style="height: 160px; overflow: auto;">
        <div class="card-body text-center">
          <%= link_to kanji.kanji_code, parts_kanji_parts_path(id: kanji.id), remote: true, class: 'underline d-inline-block w-100 fs-2 link-opacity-50-hover ink-dark' %>
          <hr class="m-1">
          <p class="card-text text-center"> <%#= kanji[:eng_mean] %> </p>
          
          <div class="position-absolute top-0 end-0 p-2">
            <%= link_to '<i class="fas fa-book-open"></i>'.html_safe, kanji_info_parts_path(id: kanji.id), remote: true, class: "btn btn-outline-primary btn-sm" %>
          <!--<button type="button" class="btn btn-sm btn-outline-primary"
          onclick="Openmodal(
            '<%= kanji.kanji_code %>', 
            '', 
            '', 
            '', 
            '<%= kanji.parts_body %>'
          )"
          data-bs-toggle="modal" data-bs-target="#kanjiModal">
          <i class="fas fa-book-open"></i>
        </button>-->
        </div>        
        </div>
      </div>
    </div>
  <% end %>
</div>
