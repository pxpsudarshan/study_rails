<% if @count != 0 %>

<div class="m-auto w-75">
<!--
  <% @gois[:vocab_kanji].each_with_index do |vocab, idx| %>
    <%= link_to vocab["kanji_code"], parts_kanji_kanji_units_path(kanji: { kanji: vocab["kanji_org"] }), remote: true, class: 'rounded-0 m-1 btn btn-primary' if vocab["kanji_org"] != 0 %>
  <% end if @gois[:vocab_kanji].present? %>
-->

<div class="container mb-5 mt-5">
  <div class="card shadow-sm rounded-0">
    <div class="card-body">
     <!-- Header Section -->
      <div class="d-flex align-items-center mb-4 border-bottom pb-3">
        <h6 class="me-auto fw-bold">JLPT <%= @gois[:jlpt_level] %><%= @vocab_mycard %></h6>
        <div id="error_explanations_required" class="w-75 bg-danger bg-opacity-50 text-center text-white fade nation_alert"></div>
        <% kanji_parts = @gois[:vocab_kanji] %>
        <div class="ms-3">
        <% kanji_parts.each do |part| %>
          <%= link_to part.kanji_code, kanjis_path(kanji: {kanji: part.kanji_code}), class: "btn btn-outline-primary btn-sm", target: '_blank' %>
        <% end %>
        <% vocab = VocabTable.find(@gois[:nation_mean].id) %>
        <% exists = vocab.vocab_nations.where(lang: current_user.lang_id).exists? %>
          <%= link_to 'Toggle', toggle_gois_path(vocab_id: @gois[:nation_mean].id), 
              class: "rounded-0 m-1 btn btn-sm btn-warning #{ exists ? '' : 'disabled' }", remote: true if current_user.access_type == User::ACCESS_TYPE::KANRISHA %>
        </div>      
      </div>

      <!-- Kanji Details -->
      <div class="text-center mb-3">
        <h4><%= @gois[:vocab_read] %></h4>
        <h2 class="fw-bold"><%= @gois[:vocab_code] %></h2>
      </div>

      <!-- Meaning Section -->
      <div class="mb-4">
        <h6 class="fw-bold">Meaning in English</h6>
        <p class="text-muted"><%= @gois[:eng_mean]&.nation_code %></p>
      </div>

      <!-- Native Language Input -->
      <%= form_for @gois[:nation_mean], url: goi_path(@gois[:nation_mean].id), html: { class: 'needs-validation', novalidate: true, role: 'form' }, remote: true do |f| %>
      <%= f.fields_for :vocab_nations, f.object.vocab_nations.where(hide_flg: false, lang: current_user.lang_id) do |vn| %>
      <div class="mb-4">
        <h6 class="fw-bold">Native Language</h6>
        <div class="d-flex">
          <div class="input-group flex-grow-1">
            <%= button_tag t('buttons.pencil').html_safe, disabled: current_user.access_type == User::ACCESS_TYPE::USER, class: 'btn btn-sm btn-secondary' %>
            <%= vn.text_field :nation_code, class: 'form-control', required: true, disabled: current_user.access_type == User::ACCESS_TYPE::USER %>
          </div>
          <div class="ms-2">
            <!-- Edit Button -->
            <!--<button class="btn btn-secondary btn-sm" id="editBtn" onclick="toggleEditSave('nativeLanguageInput', 'editBtn', 'saveBtn')">Edit</button>-->
            <!-- Save Button -->
            <!--<button class="btn btn-primary btn-sm" id="saveBtn" onclick="toggleEditSave('nativeLanguageInput', 'editBtn', 'saveBtn')" style="display: none;">Save</button>-->
          </div>
        </div>
      </div>
      <!-- Example Sentences -->

      <div class="mb-4">
        <h6 class="fw-bold">Example Sentences</h6>
        <div class="mb-2">
          <h6 class="text-muted">日本語 (Japanese)</h6>
          <p><%= @gois[:nation_mean].example %></p>
        </div>
        <div class="mb-2">
          <h6 class="text-muted">English</h6>
          <p><%= @gois[:eng_mean]&.example %></p>
        </div>
        <div class="mb-2">
          <h6 class="text-muted">Native Language</h6>
          <div class="d-flex">
            <div class="input-group flex-grow-1">
              <%= button_tag t('buttons.pencil').html_safe, disabled: current_user.access_type == User::ACCESS_TYPE::USER, class: 'btn btn-sm btn-secondary' %>
              <%= vn.text_field :example, class: 'form-control', required: false, disabled: current_user.access_type == User::ACCESS_TYPE::USER %>
            </div>
          </div>
        </div>
      </div>
      <% end %>
      <% end %>
    </div>
  </div>
  
<div class="row mt-3">
<% @cards.each do |card| %>
  <div class="col-sm-3 mt-1" style="min-width: 150px;">
    <div class="card rounded-0" style="height: 160px; overflow: auto;">
      <div class="card-body text-center">
        <div class="position-absolute top-0 end-0 m-1">
          <% if card.vocab_mycards.where(user_id: current_user.id).present? %>
          <%= '⭐️' %>
          <% end %>
        </div>
        <p class="card-text"><%= card.vocab_read %></p>
        <hr class="m-1" >
        <%= link_to card.vocab_code, jlpt_path(id: card.id), class: 'text-decoration-none d-inline-block w-100 fs-2 hover-red' %>
        <%
          text = card.vocab_nations.where(hide_flg: false, lang: current_user.lang_id)
        %>
        <hr class="m-1" >
        <p class="card-text">
        <% if text.length > 1 %>
          <% text.each_with_index do |txt, index| %>
            <%= txt.nation_code %><%= index < text.length - 1 ? ',' : '' %>
          <% end %>
        <% else %>
          <%= text.first.nation_code if text.present? %>
        <% end %>
        </p>
      </div>
    </div>
  </div>
<% end %>
</div>

</div>
<% end %>
<%= javascript_tag do %>

  'use strict';
  // Fetch all the forms we want to apply custom Bootstrap validation styles to
  var forms = document.getElementsByClassName('needs-validation');
  // Loop over them and prevent submission
  var validation = Array.prototype.filter.call(forms, function(form) {
    form.addEventListener('submit', function(event) {
      if (form.checkValidity() === false) {
        $("#error_explanations_required").text('Not Updated.');
        $("#error_explanations_required").removeClass('bg-success');
        $("#error_explanations_required").addClass('bg-danger');
        $('#error_explanations_required').addClass('show');
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  });
<% end %>
