<div class="theme-switch btn-group shadow-sm" role="group" aria-label="<%= t('theme.appearance', default: 'Appearance') %>">
  <button class="btn btn-outline-secondary btn-sm" type="button" data-theme-choice="light" aria-pressed="false"><span aria-hidden="true">☀</span> <%= t('theme.day', default: 'Day') %></button>
  <button class="btn btn-outline-secondary btn-sm" type="button" data-theme-choice="dark" aria-pressed="false"><span aria-hidden="true">☾</span> <%= t('theme.night', default: 'Night') %></button>
</div>
