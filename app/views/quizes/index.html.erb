<%= stylesheet_link_tag "quizes", media: "all", 'data-turbo-track': 'reload' %>
<h2 class="text-center my-4"><%= t("quizes.title") %></h2>
<div class="container">

  <!-- ===================== -->
  <!-- Learning History -->
  <!-- ===================== -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body text-center">
      <h5 class="card-title fw-bold mb-3"><%= t("quizes.learning_history.title") %></h5>

      <div class="row g-2">
        <div class="col-6 col-md-3">
          <%= link_to t("quizes.learning_history.one_day"), period_quizes_path(period: '1d'),
                class: 'btn btn-outline-primary w-100' %>
          <small class="text-muted d-block mt-1"><%= t("quizes.learning_history.one_day_note") %></small>
        </div>

        <div class="col-6 col-md-3">
          <%= link_to t("quizes.learning_history.one_month"), period_quizes_path(period: '1m'),
                class: 'btn btn-outline-primary w-100' %>
          <small class="text-muted d-block mt-1"><%= t("quizes.learning_history.one_month_note") %></small>
        </div>

        <div class="col-6 col-md-3">
          <%= link_to t("quizes.learning_history.three_months"), period_quizes_path(period: '3m'),
                class: 'btn btn-outline-primary w-100' %>
          <small class="text-muted d-block mt-1"><%= t("quizes.learning_history.three_months_note") %></small>
        </div>

        <div class="col-6 col-md-3">
          <%= link_to t("quizes.learning_history.all"), period_quizes_path(period: 'all'),
                class: 'btn btn-outline-dark w-100' %>
          <small class="text-muted d-block mt-1"><%= t("quizes.learning_history.all_note") %></small>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== -->
  <!-- JLPT -->
  <!-- ===================== -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <h5 class="card-title fw-bold text-center mb-3"><%= t("quizes.jlpt.title") %></h5>

      <div class="row g-2 text-center">
        <% [[:n5, 5], [:n4, 4], [:n3, 3], [:n2, 2], [:n1, 1]].each do |key, level| %>
          <div class="col-4 col-md">
            <%= link_to t("quizes.jlpt.levels.#{key}"),
                  jlpt_quizes_path(jlpt: level),
                  class: 'btn btn-outline-success w-100' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- ===================== -->
  <!-- Genre -->
  <!-- ===================== -->
  <div class="card mb-5 shadow-sm">
    <div class="card-body">
      <h5 class="card-title fw-bold text-center mb-3"><%= t("quizes.genre.title") %></h5>

      <div class="row g-2">
        <% rows = VocabGenre.where(vocab_genre_id: nil, hide_flg: false)
                            .select(:title, :sort, :id)
                            .order(:sort, :title) %>

        <% rows.each do |row| %>
          <div class="col-12">
            <%= link_to(
                  current_user.lang_id == 'JP' ? row.title :
                    (get_content(row, current_user.lang_id) || t("quizes.genre.empty")),
                  genre_quizes_path(genre_id: row.id),
                  class: 'btn btn-outline-dark rounded-0 w-100 text-wrap'
                ) %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

</div>
