<!DOCTYPE html>
<html>
<head>
  <title><%= t('title.title') %></title>
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-status-bar-style" content="black" />
  <meta name="viewport" content="user-scalable=no, width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= favicon_link_tag "favicon.ico" %>
  <%= stylesheet_link_tag "application", media: "all", 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag "login", media: "all", 'data-turbo-track': 'reload' %>
  <!-- HTML5 shim, for IE6-8 support of HTML5 elements -->
  <!--[if lt IE 9]>
    <%= javascript_include_tag 'html5shiv' %>
  <![endif]-->
  <%= render partial: "shared/theme_head", formats: [:html] %>
</head>
<body>
  <%= render partial: "shared/theme_switch", formats: [:html] %>
<%= javascript_include_tag 'application', 'data-turbo-track': 'reload' %>
  <main class="form-signin w-100 m-auto">
  <!-- Language selector -->
  <% if action_name == 'new' && @locales.size > 1 %>
    <div class="language-selector text-end d-flex justify-content-end align-items-center mb-3">
      <%= select_tag 'select_language', options_for_select(@locales, @locale), class: 'form-select w-auto d-inline-block me-2' %>
    </div>
  <% end %>
  <%= bootstrap_flash %>
  <%= yield %>
  <%= render partial: "shared/footer" %>
  </main>  
  <%= javascript_tag do %>
    // 🌍 Language change
    $('#select_language').change(function() {
      location.href = "?locale=" + $(this).val();
    });

  <% end %>
</body>
</html>
