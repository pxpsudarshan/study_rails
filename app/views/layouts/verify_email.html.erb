<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8" />
  <title><%= t('email_verification.title') %> | <%= t('title.title') %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="turbolinks-cache-control" content="no-cache">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= favicon_link_tag "favicon.ico" %>
  <%= stylesheet_link_tag "application", "verify_email", media: "all", 'data-turbo-track': 'reload' %>
  <%= javascript_include_tag "application", 'data-turbo-track': 'reload' %>
</head>
<body class="verification-page min-vh-100">
  <header class="verification-header mx-auto px-4 py-4 d-flex align-items-center justify-content-between gap-3">
    <%= image_tag 'niho_logo_newBlack.svg', alt: 'NIHO', class: 'verification-logo' %>
    <nav class="verification-languages d-flex gap-3 small" aria-label="<%= t('email_verification.language') %>">
      <% [['日本語', :ja], ['English', :en]].each do |label, locale| %>
        <%= link_to label, verify_email_users_path(locale: locale), lang: locale, class: 'text-decoration-none py-2', aria: { current: (I18n.locale == locale ? 'page' : nil) } %>
      <% end %>
    </nav>
  </header>
  <main class="verification-main mx-auto mt-3">
    <%= bootstrap_flash %>
    <%= yield %>
  </main>
  <footer class="text-center text-muted small py-4">NIHO PROJECT</footer>
</body>
</html>
