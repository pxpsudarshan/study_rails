<!DOCTYPE html>
<html>
<head>
  <title><%= t('title.title') %></title>
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-status-bar-style" content="black" />
  <meta name="viewport" content="user-scalable=no, width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <meta name="turbolinks-cache-control" content="no-cache">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= favicon_link_tag "favicon.ico" %>
  <%= stylesheet_link_tag "application", media: "all", 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag "sb-admin-2", media: "all", 'data-turbo-track': 'reload' %>
  <%= yield :stylesheet %>
  <%= javascript_include_tag "application", 'data-turbo-track': 'reload' %>
  <%= javascript_include_tag "locales/#{locales}/common.messages" %>
  <%= individual_javascript_include_tag %>
  <!-- HTML5 shim, for IE6-8 support of HTML5 elements -->
  <!--[if lt IE 9]>
    <%= javascript_include_tag 'html5shiv' %>
  <![endif]-->
</head>
<body>
  <% if controller_name != 'mains' %>
  <nav class="navbar navbar-expand-md navbar-dark bg-black bg-gradient">
  <div class="container-fluid bg-black bg-gradient">
      <a class="navbar-brand active p-0" href="<%= current_user.present? ? menus_path : kaisha_menus_path %>">
        <%= image_tag("niho_logo_newWhite.svg", class: "d-inline-block mt-3", alt: "NIHO", style:"position: relative;z-index: 1;left: 20px;height: 60px;") %>
      </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbar-collapse" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- navbar-header -->
    <!-- Collect the nav links, forms, and other content for toggling -->
    <div class="collapse navbar-collapse" style="margin-left: 40px;top: 20px;position: relative;">
      <% if action_name != 'new_user' %>
      <ul class="navbar-nav me-auto mb-2 mb-md-0">
        <% if current_comp.present? %>
          <!-- <li class="nav-item"><%#= link_to t('navbar.comp').html_safe, kaisha_comps_path, class: "nav-link" %></li> -->
          <li class="nav-item"><%= link_to t('navbar.company_store').html_safe, new_kaisha_company_store_path, class: "nav-link text-white" %></li>
          <li class="nav-item"><%= link_to t('navbar.job_profile').html_safe, kaisha_job_profiles_path, class: "nav-link text-white" %></li>
          <li class="nav-item"><%= link_to t('navbar.offer').html_safe, kaisha_offers_path, class: "nav-link text-white" %></li>
        <% else %>
          <!--<li class="nav-item"><%#= link_to t('navbar.user').html_safe, users_path, class: "nav-link text-white" %></li>-->
          <li class="nav-item"><%= link_to t('navbar.store').html_safe, new_store_path, class: "nav-link text-white" %></li>
          <li class="nav-item ps-4"><%= link_to t('navbar.job').html_safe, jobs_path, class: "nav-link text-white" %></li>
        <% end %>
        <% if current_comp.present? ||
               current_user.present? && (current_user.access_type != User::ACCESS_TYPE::USER) %>
        <li class="nav-item ps-4"></li>
        <li class="nav-item dropdown">
          <a class="nav-link text-white dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" href="#"><%== t('navbar.master') %><span class="caret"></span></a>
          <ul class="dropdown-menu">
            <% if current_comp.present? %>
              <% if current_comp.access_type != Comp::ACCESS_TYPE::OTHER %>
                <li><%= link_to t('navbar.comp').html_safe, kaisha_comps_path, class: "dropdown-item" %></li>
              <% end %>
              <li><%= link_to t('navbar.user').html_safe, kaisha_users_path, class: "dropdown-item" %></li>
              <li><%= link_to t('navbar.progress').html_safe, kaisha_progress_index_path, class: "dropdown-item" %></li>
            <% elsif current_user.access_type == User::ACCESS_TYPE::KANRISHA %>
              <li><%= link_to t('navbar.channel').html_safe, admin_channels_path, class: "dropdown-item" unless current_user.comp&.channel_id.present? %></li>
              <li><%= link_to t('navbar.block_ip').html_safe, admin_block_ips_path, class: "dropdown-item" unless current_user.comp&.channel_id.present? %></li>
              <li><%= link_to t('navbar.parts_table').html_safe, admin_parts_tables_path, class: "dropdown-item" unless current_user.comp&.channel_id.present? %></li>
              <li><%= link_to t('navbar.kanji_table').html_safe, admin_kanji_tables_path, class: "dropdown-item" unless current_user.comp&.channel_id.present? %></li>
              <li><%= link_to t('navbar.vocab_genre').html_safe, admin_vocab_genres_path, class: "dropdown-item" %></li>
              <li><%= link_to t('navbar.vocab_table').html_safe, admin_vocab_tables_path, class: "dropdown-item" %></li>
              <li><%= link_to t('navbar.audio_a').html_safe, admin_audio_as_path, class: "dropdown-item" %></li>
              <li><%= link_to t('navbar.tokutei').html_safe, admin_tokuteis_path, class: "dropdown-item" %></li>
              <% else %>
              <li><%= link_to t('navbar.vocab_table').html_safe, admin_vocab_tables_path, class: "dropdown-item" %></li>
              <li><%= link_to t('navbar.audio_a').html_safe, admin_audio_as_path, class: "dropdown-item" %></li>
              <li><%= link_to t('navbar.tokutei').html_safe, admin_tokuteis_path, class: "dropdown-item" %></li>
<!--            <li><%#= link_to t('navbar.user').html_safe, admin_users_path, class: "dropdown-item" %></li>-->
            <% end %>
          </ul>
        </li>
        <% end %>
      </ul>
      <% end if (current_user.present? || current_comp.present?) %>
      <ul class="navbar-nav ms-auto mb-2 mb-md-0">
        <% if action_name != 'new_user' %>
        <li class="nav-item mb-3 dropdown">
          <a class="nav-link dropdown-toggle text-white" data-bs-toggle="dropdown" aria-expanded="false" href="#">
            <%== current_user.present? ? current_user.name : current_comp.name %>
            <span class="caret"></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><%= link_to t('navbar.edit_user').html_safe, current_user.present? ? edit_user_path(current_user.id) : edit_kaisha_comp_path(current_comp.id), class: "dropdown-item" %></li>
            <% if current_user.present? %>
            <li><%= link_to t('navbar.profile').html_safe, profile_user_path(current_user.id), class: "dropdown-item" %></li>
            <% end %>
            <li><%= link_to t('navbar.logout').html_safe, current_user.present? ? destroy_user_session_path : destroy_comp_session_path, method: 'delete', class: "dropdown-item" %></li>
          </ul>
        </li>
        <% end if (current_user.present? || current_comp.present?) %>
        <li>
          <% if @locales.size > 1 && action_name == 'new_user' %>
          <form class="mb-4 d-flex ms-auto">
            <%= select_tag 'select_language', options_for_select(@locales, @locale), class: 'form-select me-2' %>
          </form>
          <% end %>
        </li>
      </ul>
    </div>
  </div>
    <!-- /.navb ar-static-side -->
  </nav>
  <hr class="m-0 student-line top-ten"></hr>
  <% else %>
    <%= image_tag('backphoto_02.jpg', class: 'my-image', alt: 'background Image') if action_name != 'new_user' %>
  <% end %>
  <main class="overflow-hidden">
    <%= render partial: "shared/breadcrumbs", formats: [:html] %>
    <%= bootstrap_flash %>
    <%= yield %>
  </main>
  <%= javascript_tag do %>
    $('#select_language').change(function() {
      location.href= "?locale=" + $(this).val();
    });
  <% end %>
</body>
</html>
