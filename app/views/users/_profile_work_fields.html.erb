<div class="nested-fields mb-3">
  <div class="row g-2 align-items-end">

    <!-- 勤務国 -->
    <div class="col-md-1">
      <div class="col-form-label small mb-1">
        <%= f.label :work_country %>
      </div>
      <%= f.select :work_country, options_for_select(work_country_array, f.object.work_country), { include_blank: true }, class: 'form-select form-select-sm' %>
    </div>

    <!-- 勤務先 -->
    <div class="col-md-4">
      <div class="col-form-label small mb-1">
        <%= f.label :work_place %>
      </div>
      <%= f.text_field :work_place, placeholder: t('placeholder.work_place'), class: 'form-control form-control-sm' %>
    </div>

    <!-- 職業 -->
    <div class="col-md-2">
      <div class="col-form-label small mb-1">
        <%= f.label :work_type %>
      </div>
      <%= f.text_field :work_type, placeholder: t('placeholder.work_type'), class: 'form-control form-control-sm' %>
    </div>

    <!-- 開始年月 -->
    <div class="col-md-2">
      <div class="col-form-label small mb-1">
        <%= f.label :start_date %>
      </div>
      <div class="d-flex gap-1">
        <%= f.date_select :start_date, { discard_day: true, start_year: Time.current.year - 15, end_year: Time.current.year }, { class: 'form-select form-select-sm' } %>
      </div>
    </div>

    <!-- 区切り（固定幅） -->
    <div class="col-md-1 text-center">
      <div class="col-form-label small mb-1 invisible">~</div>
      <span class="fw-bold">~</span>
    </div>

    <!-- 終了年月 -->
    <div class="col-md-2">
      <div class="col-form-label small mb-1">
        <%= f.label :end_date %>
      </div>
      <div class="d-flex gap-1">
        <%= f.date_select :end_date, { discard_day: true, start_year: Time.current.year - 15, end_year: Time.current.year + 1 }, { class: 'form-select form-select-sm' } %>
      </div>
    </div>

    <!-- 削除ボタン -->
    <div class="col-md-12 text-end mt-2">
      <%= link_to_remove_association t('buttons.delete').html_safe, f, class: "btn btn-danger btn-sm" %>
    </div>

  </div>

  <hr class="mt-2">
</div>
