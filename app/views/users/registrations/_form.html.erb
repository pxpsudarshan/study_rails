<section class="registration-card card border-student rounded-0 mx-auto" aria-labelledby="registration-title">
  <div class="card-body p-4 p-sm-5">
    <div class="mb-4">
      <h1 id="registration-title" class="h3 mb-2"><%= t('.title') %></h1>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'form-horizontal' }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>
      <div class="row g-3 mb-3">
        <% { sei: 'family-name', mei: 'given-name' }.each do |attribute, autocomplete| %>
          <div class="col-sm-6">
            <div class="form-floating">
              <%= f.text_field attribute, placeholder: t("activerecord.attributes.user.#{attribute}"),
                    autocomplete: autocomplete, required: true, class: 'form-control' %>
              <%= f.label attribute %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="form-floating mb-3">
        <%= f.email_field :email, placeholder: 'name@example.com',
              autocomplete: 'email', required: true, class: 'form-control' %>
        <%= f.label :email %>
      </div>
      <div class="form-floating mb-3">
        <%= f.select :lang_id, options_for_select(langs, f.object.lang_id),
              { prompt: t('.select_language') }, required: true, class: 'form-select' %>
        <%= f.label :lang_id %>
      </div>
      <div class="form-floating mb-3">
        <%= f.password_field :password, placeholder: t('activerecord.attributes.user.password'),
              autocomplete: 'new-password', required: true,
              minlength: Devise.password_length.min, maxlength: Devise.password_length.max, class: 'form-control' %>
        <%= f.label :password %>
      </div>
      <div class="form-floating mb-4">
        <%= f.password_field :password_confirmation, placeholder: t('activerecord.attributes.user.password_confirmation'),
              autocomplete: 'new-password', required: true, class: 'form-control' %>
        <%= f.label :password_confirmation %>
      </div>
      <%= f.submit t('.review'), class: 'w-100 btn btn-lg btn-dark rounded-0' %>
    <% end %>

    <div class="border-top mt-4 pt-4 text-center">
      <%= link_to t('users.shared.links.sign_in'), new_session_path(resource_name), class: 'text-decoration-underline' %>
    </div>
  </div>
</section>
