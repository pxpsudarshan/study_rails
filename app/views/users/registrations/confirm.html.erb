<section class="registration-card card border-student rounded-0 mx-auto" aria-labelledby="registration-title">
  <div class="card-body p-4 p-sm-5">
    <h1 id="registration-title" class="h3 mb-4"><%= t('.title') %></h1>
    <dl class="mb-4">
      <% [:sei, :mei, :email].each do |attribute| %>
        <dt class="small text-muted mb-1"><%= t("activerecord.attributes.user.#{attribute}") %></dt>
        <dd class="text-break mb-3"><%= resource[attribute] %></dd>
      <% end %>
      <dt class="small text-muted mb-1"><%= t('activerecord.attributes.user.lang_id') %></dt>
      <dd class="mb-3"><%= langs(resource[:lang_id]).first&.first %></dd>
    </dl>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'form-horizontal' }) do |f| %>
      <%= recaptcha_v3(action: 'signup') %>
      <%= hidden_field_tag :confirmed, "true" %>
      <%= f.hidden_field :sei %>
      <%= f.hidden_field :mei %>
      <%= f.hidden_field :lang_id %>
      <%= f.hidden_field :email %>
      <%= f.hidden_field :password %>
      <%= f.hidden_field :password_confirmation %>
      <div class="registration-actions d-flex justify-content-between gap-2">
        <%= f.button t('.edit'), type: :submit, name: 'back_button', value: 'true', class: 'btn btn-outline-dark rounded-0' %>
        <%= f.submit t('.send_email'), class: 'btn btn-dark rounded-0' %>
      </div>
    <% end %>
  </div>
</section>
