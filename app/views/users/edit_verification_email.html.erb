<section class="card w-50 m-auto border-3 rounded-0 border-student text-center" aria-labelledby="change-email-title">
  <%= embedded_svg 'niho_logo_newBlack.svg', class: 'm-4 mx-auto' %>
  <div class="px-4 pb-4">
    <h1 id="change-email-title" class="h3 mb-3 fw-normal"><%= t('email_verification.change_email') %></h1>
    <p class="small text-muted mb-4"><%= t('email_verification.change_email_hint') %></p>
    <%= form_with model: @user, url: update_verification_email_users_path, method: :patch, local: true do |f| %>
      <%= render 'users/shared/error_messages', resource: @user %>
      <div class="form-floating mb-3">
        <%= f.email_field :email, placeholder: 'name@example.com', required: true, autocomplete: 'email', class: 'form-control' %>
        <%= f.label :email, t('email_verification.recipient') %>
      </div>
      <%= f.submit t('email_verification.save_email'), class: 'btn btn-lg btn-dark rounded-0 w-100' %>
    <% end %>
    <%= link_to t('email_verification.back'), verify_email_users_path, class: 'd-block text-center text-secondary text-decoration-underline small mt-3' %>
  </div>
</section>
