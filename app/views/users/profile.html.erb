<%= form_for @user, url: update_profile_user_path,
             html: { class: 'needs-validation w-75 m-auto', multipart: true, novalidate: true, id: 'profile', role: 'form' } do |f| %>

  <% if @user.errors.any? %>
    <div class="row">
      <div class="col-md-12">
        <div id="error_explanations" class="alert fade show alert-danger">
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= content_tag(:div, msg) %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="gap-3">
    <div class="step step-1">
      <%= render 'profile_step1', f: f %>
    </div>

    <div class="step step-2">
      <%= render 'profile_step2', f: f %>
    </div>

    <div class="step step-3">
      <%= render 'profile_step3', f: f %>
    </div>
  </div>
<% end %>
<%= javascript_tag do %>
  function show_image(e) {
    var file = e.files[0];
    if (!file) return;

    var fileName = file.name.toLowerCase();
    var isJpgPng =
      fileName.endsWith('.jpg') ||
      fileName.endsWith('.jpeg') ||
      fileName.endsWith('.png');

    if (!isJpgPng) {
      alert('JPG / PNG 形式の画像のみアップロードできます。');
      $(this).val('');
      return;
    }

    var reader = new FileReader();

    reader.onload = function(ev) {
      var $img         = $('#profile-photo-preview');
      var $placeholder = $('#profile-photo-placeholder');

      $img.attr('src', ev.target.result).removeClass('d-none').show();          // 画像を表示
      $placeholder.hide();  // 「写真なし」を隠す
    };

    reader.readAsDataURL(file);
  };
<% end %>
