<div class="row g-2 mb-1 nested-fields" >
    <div class="col-12 col-md-5">
        <%= f.select :use_lang, options_for_select(second_langs, f.object.use_lang), { include_blank: true }, class: 'form-select' %>
    </div>
    <div class="col-12 col-md-4">
        <%= f.select :use_lang_level, options_for_select(language_level, f.object.use_lang_level), {include_blank: true }, class: 'form-select' %>
    </div>
    <div class="ol-12 col-md-auto d-flex justify-content-end">
        <%= link_to_remove_association t('buttons.delete').html_safe, f, class: "btn btn-danger btn-sm px-3" %>
    </div>
</div>
