<section class="bg-white border rounded-4 shadow-sm text-center p-4 p-sm-5" aria-labelledby="verification-title">
  <div class="verification-icon d-flex align-items-center justify-content-center mx-auto mb-4 rounded-4" aria-hidden="true">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </svg>
  </div>
  <p class="verification-eyebrow small fw-bold mb-2"><%= t('email_verification.eyebrow') %></p>
  <h1 id="verification-title" class="h3 fw-bold mb-3"><%= t('email_verification.title') %></h1>
  <p class="text-muted small lh-lg mb-0"><%= t('email_verification.description') %></p>
  <% if current_user.present? %>
    <div class="border rounded-3 p-3 mt-4">
      <span class="d-block text-muted small mb-1"><%= t('email_verification.recipient') %></span>
      <strong class="small text-break"><%= current_user.email %></strong>
      <%= link_to t('email_verification.change_email'), edit_verification_email_users_path, class: 'd-block small text-secondary mt-2' %>
    </div>
  <% end %>
  <ol class="verification-steps list-unstyled text-start small my-4">
    <li><%= t('email_verification.step_open') %></li>
    <li><%= t('email_verification.step_verify') %></li>
  </ol>
  <aside class="bg-light rounded-3 p-3 text-start" aria-labelledby="verification-help-title">
    <h2 id="verification-help-title" class="small fw-bold mb-2"><%= t('email_verification.help_title') %></h2>
    <p class="small text-muted lh-lg mb-0"><%= t('email_verification.help_body') %></p>
    <% if current_user.present? %>
      <%= button_to t('email_verification.resend'), resend_verification_email_users_path, method: :post, class: 'btn btn-outline-secondary btn-sm mt-3' %>
      <p class="small text-muted mt-2 mb-0"><%= t('email_verification.resend_hint') %></p>
    <% else %>
      <p class="small text-muted mt-2 mb-0"><%= t('email_verification.sign_in_to_resend') %></p>
    <% end %>
  </aside>
  <div class="mt-4">
    <% if current_user.present? %>
      <%= button_to t('email_verification.back_to_login'), back_to_login_users_path, method: :post, class: 'btn btn-link text-secondary small mt-2' %>
    <% else %>
      <%= link_to t('email_verification.sign_in'), new_user_session_path, class: 'btn btn-dark w-100 py-3 rounded-3 small' %>
    <% end %>
    <p class="small text-muted mt-3 mb-0"><%= t('email_verification.link_hint') %></p>
  </div>
</section>
