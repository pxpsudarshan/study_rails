<section class="card w-50 m-auto border-3 rounded-0 border-student text-start">
  <div class="px-4 pb-4">
  <% if @canceled_at.present? %>
  <p><b>Your subscription ended on <%= @canceled_at %></b></p>

  <p>Your <%= @product_name %> ended on <%= @canceled_at %>.<br>
To continue using NIHO, a subscription fee will apply (<%= @user_price %>).<br>
If you add a payment method, the added payment method will be charged <%= @user_price %>.<br><br>
  <div class="mt-4 text-center">
    <%= link_to 'Subscription', @payment_link, class: 'w-75 m-auto btn btn-lg btn-dark rounded-0' %>
  </div>
  </p>
  <% elsif @canceled_at.blank? && @end_date.blank? && current_user.subscription_status == 'incomplete' %>
  <p><b>Need subscription.</b></p>

  <p>Your <%= @product_name %> needs a valid subscription.<br>
To continue using NIHO, a subscription fee will apply (<%= @user_price %>).<br>
If you add a payment method, the added payment method will be charged <%= @user_price %>.<br><br>
  <div class="mt-4 text-center">
    <%= link_to 'Subscription', @payment_link, class: 'w-75 m-auto btn btn-lg btn-dark rounded-0' %>
  </div>
  </p>
  <% else %>
    <% if @end_date.present? %>
  <p><b>Your free trial ended on <%= @end_date %></b></p>

  <p>Your free trial for <%= @product_name %> ended on <%= @end_date %>.<br>
To continue using NIHO, a subscription fee will apply (<%= @user_price %>).<br>
If you add a payment method, the added payment method will be charged <%= @user_price %>.<br><br>
    <% else %>
  <p><b>Your subscription needs review</b></p>

  <p>Your <%= @product_name %> needs review.<br>
To continue using NIHO, please check the status by clicking the button below.<br><br>
    <% end %>
  <div class="mt-4 text-center">
    <%= link_to 'Manage your subscriptions', Rails.env.development? ? "https://billing.stripe.com/p/login/test_3cI3cw4v27ht3KDbyHaMU00" : "https://billing.stripe.com/p/login/3cI3cw4v27ht3KDbyHaMU00", target: '_blank', class: 'w-75 m-auto btn btn-lg btn-dark rounded-0' %>
  </div>
  </p>
  <% end %>
    <div class="mt-4 text-center">
      <%= link_to t('email_verification.back_to_login'), back_to_login_users_path, class: 'btn btn-link text-secondary small mt-2' %>
    </div>
  </div>
</section>
