<%= stylesheet_link_tag "jlpt", media: "all", 'data-turbo-track': 'reload' %>
<%= form_for :goi, url: foreigns_path, html: { id: 'gois', role: 'form', method: :get }, remote: true do |f| %>
  <div class="w-100 p-3">
    <%= f.text_field :goi, class: 'form-control' %>
    <%= f.submit 'next', class: 'btn btn-primary rounded-0 m-1' %>
  </div>
<% end %>
<div class="row">
  <div class="col-md-12" id="part"></div>
</div>
<div class="row">
  <div class="col-md-12" id="kanji_unit"></div>
</div>
