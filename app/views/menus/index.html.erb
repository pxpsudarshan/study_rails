<div class="home-page w-100 p-3">
  <header class="home-welcome mb-4">
    <h1 class="h3 fw-bold mb-2"><%= t('home.welcome', name: current_user.name.strip) %></h1>
    <p class="text-muted mb-0"><%= t('home.intro') %></p>
  </header>

  <section aria-labelledby="home-progress" class="home-progress p-3 p-lg-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <h2 id="home-progress" class="h5 fw-bold mb-0"><%= t('home.progress') %></h2>
      <%= link_to t('home.progress_details'), charts_path, class: 'home-text-link' %>
    </div>
    <div class="row g-3 mb-3">
      <% [['feature.mycard', @card_total], ['home.studying', @card_studying], ['home.learned', @card_learned]].each do |label, count| %>
        <div class="col-4"><p class="small text-muted mb-1"><%= t(label) %></p><p class="h3 fw-bold mb-0"><%= number_with_delimiter(count) %></p></div>
      <% end %>
    </div>
    <% if @card_total.zero? %>
      <p class="small text-muted mb-3"><%= t('home.empty') %></p>
    <% else %>
      <div class="d-flex justify-content-between small mb-2"><span><%= t('home.learned_ratio') %></span><span><%= @learned_percent %>%</span></div>
      <div class="progress mb-3" style="height: 8px"><div class="progress-bar home-progress-bar" role="progressbar" style="width: <%= @learned_percent %>%" aria-valuenow="<%= @learned_percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= t('home.learned_ratio') %>"></div></div>
    <% end %>
    <%= link_to t(@card_total.zero? ? 'home.start' : 'home.review'), @card_total.zero? ? gois_path : vocab_mycards_path, class: 'btn home-primary rounded-0 px-4' %>
  </section>

  <section aria-labelledby="home-learn" class="mb-4">
    <h2 id="home-learn" class="h5 fw-bold mb-3"><%= t('home.learn') %></h2>
    <div class="row g-3">
      <% [['feature.vocab_hiragana', 'home.vocab_hint', gois_path, 'book'], ['feature.vocab_native', 'home.native_hint', foreigns_path, 'language'], ['feature.kanji', 'home.kanji_hint', kanjis_path, 'font'], ['feature.parts', 'home.parts_hint', parts_path, 'puzzle-piece'], ['feature.conversation', 'home.conversation_hint', specified_conversations_path, 'comments'], ['feature.quiz', 'home.quiz_hint', quizes_path, 'question-circle']].each do |label, hint, path, icon| %>
        <div class="col-12 col-md-6 col-xl-4">
          <%= link_to path, class: 'home-learning-card d-flex align-items-center gap-3 p-3 h-100' do %>
            <i class="fas fa-<%= icon %> fa-fw home-learning-icon" aria-hidden="true"></i>
            <div class="flex-grow-1"><h3 class="h6 fw-bold mb-1"><%= t(label) %></h3><p class="small text-muted mb-0"><%= t(hint) %></p></div>
            <span aria-hidden="true">›</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%#= link_to 'Specific skill word', specified_vocabs_path, class: 'btn btn-outline-dark rounded-0' %>
  <%#= link_to 'kanji_scroll', kanji_scrolls_path, class: 'btn btn-outline-dark rounded-0' %>

  <section aria-labelledby="home-materials" class="mb-3">
    <h2 id="home-materials" class="h5 fw-bold mb-3"><%= t('home.materials') %></h2>
    <h3 class="h6 fw-bold mb-3"><%= t('home.jlpt') %></h3>
    <div class="row g-3">
      <% 5.downto(1) do |level| %>
        <div class="col-6 col-md-4 col-lg">
          <%= link_to jlpts_path(jlpt: level), class: 'home-material-card card h-100 rounded-0 text-decoration-none text-dark' do %>
            <div class="home-material-cover home-material-cover-jlpt" aria-hidden="true">
              <span class="small fw-bold">JLPT</span>
              <span class="home-material-level">N<%= level %></span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-between gap-2 p-3">
              <h4 class="h6 fw-bold mb-0">JLPT N<%= level %></h4>
              <span aria-hidden="true">›</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if @genres.any? %>
      <h3 class="h6 fw-bold mt-4 mb-3"><%= t('home.genres') %></h3>
      <div class="row g-3">
        <% @genres.each do |genre| %>
          <% title = get_content(genre, @lang) if @lang.present? && @lang != 'JP' %>
          <div class="col-6 col-md-4 col-xl-3">
            <%= link_to vocab_genres_path(id: genre.id), class: 'home-material-card card h-100 rounded-0 text-decoration-none text-dark' do %>
              <div class="home-material-cover" aria-hidden="true">
                <i class="fas fa-book-open"></i>
              </div>
              <div class="card-body d-flex align-items-center justify-content-between gap-2 p-3">
                <h4 class="h6 fw-bold mb-0"><%= strip_tags(title.presence || genre.title).strip %></h4>
                <span aria-hidden="true">›</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
